rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Product images are part of the public storefront catalog.
    match /products/{productId}/{fileName} {
      allow read: if true;

      // The admin dashboard requires Firebase Authentication. Keep uploads
      // image-only and bounded to prevent the bucket being used for arbitrary
      // or unexpectedly large files.
      allow create, update: if request.auth != null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null;
    }

    // Deny access to every path that has not been explicitly allowed above.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
